# ============================================
# KrishiSathi Backend — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# The app works with just GEMINI_API_KEY set.
# Other services fall back to mock data gracefully.

# ===========================================
# REQUIRED — Get from https://aistudio.google.com/apikey
# ===========================================
GEMINI_API_KEY=your-gemini-api-key-here

# ===========================================
# OPTIONAL — Enhanced features
# ===========================================

# Google Cloud Project (for Translation, STT, TTS)
GOOGLE_CLOUD_PROJECT=

# Google Maps API Key
GOOGLE_MAPS_API_KEY=

# OpenWeather API Key (free: https://openweathermap.org/api)
OPENWEATHER_API_KEY=

# Twilio WhatsApp (free sandbox: https://www.twilio.com/try-twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Firebase (for Firestore persistence)
FIREBASE_PROJECT_ID=
