# ============================================
# KrishiSathi Backend — Environment Variables
# ============================================
# Copy to .env. Nothing here falls back to mock data: a missing integration
# makes the affected feature return an explicit "unavailable" state or HTTP 503.

ENVIRONMENT=development          # "production" requires DATABASE_URL/POSTGRES_URL and REDIS_URL/KV_URL

# --- AI (diagnosis, advisory, voice, policy report) ---------------------------
# Get a key at https://aistudio.google.com/apikey. Without it AI endpoints return 503.
GEMINI_API_KEY=
# GEMINI_DIAGNOSIS_MODEL=gemini-2.5-flash
# GEMINI_ADVISORY_MODEL=gemini-2.5-flash
# GEMINI_TRANSCRIPTION_MODEL=gemini-2.5-flash
# GEMINI_AGENT_MODEL=gemini-2.5-flash       # used for the policymaker report
# Read-aloud voice: Gemini speech for these languages, Google Translate TTS (native voice) for the rest.
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts   # empty disables Gemini speech
# GEMINI_TTS_VOICE=Kore
# GEMINI_TTS_LANGUAGES=en,hi,mr,ta,te,bn
# AI_TIMEOUT_SECONDS=45
# EXTERNAL_API_TIMEOUT_SECONDS=10

# --- Persistence -------------------------------------------------------------
# Defaults to SQLite (./krishisathi.db) outside production.
DATABASE_URL=
REDIS_URL=                        # rate limiting, idempotency, caching (in-process fallback when absent)
RATE_LIMIT_AI=10                  # AI requests per minute per client IP
# Diagnosis safety (moderate | high; cannot be set lower than moderate)
# DIAGNOSIS_CHEMICAL_MIN_CERTAINTY=moderate
# DIAGNOSIS_SUPPORTED_MIN_CERTAINTY=high

# --- Security ----------------------------------------------------------------
# Signs/verifies federation publisher JWTs (HS256). Without it, publishing is disabled (fail closed).
JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:3000
# CORS_ALLOWED_ORIGIN_REGEX=^https://krishisathi-[a-z0-9-]+\.vercel\.app$
TRUST_REVERSE_PROXY=false         # set true only behind a proxy that overwrites X-Forwarded-For

# --- Optional integrations ---------------------------------------------------
# Sentinel-2 crop health via Google Earth Engine (docs/EARTH_ENGINE.md). The service-account JSON key,
# raw or base64-encoded. Without it, satellite crop health reports "unavailable". Never commit the key.
# The source shows "Enabled" only after Earth Engine accepts the key and answers for COPERNICUS/S2_SR_HARMONIZED.
EE_SERVICE_ACCOUNT_KEY_JSON=
# EE_PROJECT=                     # Cloud project registered for Earth Engine, if not the key's project_id.
#                                 # Set alone (no key) to use Application Default Credentials.
# BigQuery diagnosis telemetry (optional; dropped with a log line when unset)
GOOGLE_CLOUD_PROJECT=
